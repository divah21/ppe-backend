# ---- Server ---------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_VERSION=v1
# Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000
# Base URL used for links inside emails
FRONTEND_URL=http://localhost:3000

# ---- Database -----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ppe
DB_USER=postgres
DB_PASSWORD=

# Folder containing pg_dump/psql for backups; auto-detected under C:\Program Files\PostgreSQL when unset
# PG_BIN_PATH=C:\Program Files\PostgreSQL\17\bin

# ---- Auth ---------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# ---- Email (SMTP) ---------------------------------------------------------------
# Gmail needs an App Password (2FA required). Leave blank locally when the
# database holds real employee addresses.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
# Optional; defaults to "PPE Management System" <EMAIL_USER>. Gmail rejects a From
# address other than EMAIL_USER or a verified alias.
EMAIL_FROM=

# ---- Scheduled jobs ----------------------------------------------------------------
# Daily renewal / low-stock notification emails
ENABLE_CRON=false
TIMEZONE=Africa/Harare
# Backup schedule timezone; also changes Node's process timezone
# TZ=Africa/Harare

# ---- Debug --------------------------------------------------------------------
DEBUG_MATRIX=0
